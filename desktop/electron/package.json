{
  "name": "darkarmy-dossier-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron-обёртка DarkArmy Dossier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.darkarmy.dossier",
    "productName": "DarkArmy Dossier",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icons/**"],
    "win": { "target": ["nsis", "portable"], "icon": "icons/icon-512.png" },
    "linux": { "target": ["AppImage", "deb"], "icon": "icons/icon-512.png", "category": "Office" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
