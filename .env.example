# ===== DarkArmy Dossier — пример окружения =====
# Скопируй в .env и заполни. Реальные значения в git не коммитить.
#
# NODE_ENV=production включает secure-cookie, HSTS, отключение отладочных
# предупреждений. Для локальной разработки можно оставить development.
NODE_ENV=production

# Порт HTTP-сервера
PORT=7561

# Адрес, который слушает сервер. Для локальной машины — 127.0.0.1,
# для доступа из локальной сети — 0.0.0.0 (только за reverse proxy с HTTPS).
BIND_HOST=127.0.0.1

# Секрет подписи сессионных cookie. Обязателен в production.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Каталог с проектами (файлы пользователей). По умолчанию F:/Проекты.
PROJECTS_ROOT=F:/Проекты

# Каталог метаданных (JSON/SQLite). По умолчанию <repo>/data.
# DATA_DIR=data

# Доверять X-Forwarded-* от reverse proxy: false | true | число хопов.
TRUST_PROXY=false

# Разрешённые хосты Ollama для Darcus (через запятую). Пусто — проверка по NODE_ENV.
DARCUS_ALLOWED_HOSTS=

# Whisper (STT). Пусто — распознавание речи недоступно.
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANG=ru

# TTS-сервер. Пусто — используется браузерный синтез.
TTS_URL=
TTS_VOICE=default
TTS_FORMAT=wav

# Уровень логов: trace | debug | info | warn | error
LOG_LEVEL=info
