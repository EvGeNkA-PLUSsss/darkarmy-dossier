# ===== DarkArmy Dossier — пример окружения =====
# Скопируй в .env и заполни. Реальные значения в git не коммитить.
#
# NODE_ENV=production включает secure-cookie, HSTS, отключение отладочных
# предупреждений. Для локальной разработки можно оставить development.
NODE_ENV=production

# Порт HTTP-сервера
PORT=7561

# Адрес, который слушает сервер:
#   127.0.0.1 — только этот ПК (безопасно по умолчанию),
#   0.0.0.0   — доступ из локальной сети (разрешите порт в брандмауэре, см. README → LAN).
BIND_HOST=127.0.0.1

# Секрет подписи сессионных cookie. Обязателен в production.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Каталог с проектами (файлы пользователей). По умолчанию F:/Проекты.
PROJECTS_ROOT=F:/Проекты

# Каталог метаданных (SQLite + JSON-архив). По умолчанию <repo>/data.
# DATA_DIR=data

# Каталог резервных копий. По умолчанию <repo>/../backups.
# BACKUP_DIR=../backups

# Доверять X-Forwarded-* от reverse proxy: false | true | число хопов.
TRUST_PROXY=false

# Разрешённые хосты Ollama для Darcus (через запятую). Пусто — проверка по NODE_ENV.
DARCUS_ALLOWED_HOSTS=

# Whisper (STT). Пусто — распознавание речи недоступно.
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANG=ru

# TTS-сервер (JSON {text,voice,format,language} → аудио).
# Пусто — используется браузерный синтез. Например, локальный Silero TTS API.
TTS_URL=

# Дополнительный HTTPS-порт (тот же сервер). Нужен для микрофона на LAN:
# браузер разрешает getUserMedia только на HTTPS/localhost.
# Сертификат: data/tls/dossier.pfx (самоподписанный, данные для телефона — audit/tls/*.cer)
HTTPS_PORT=
HTTPS_PFX=data/tls/dossier.pfx
HTTPS_PFX_PASS=
TTS_VOICE=default
TTS_FORMAT=wav

# Уровень логов: trace | debug | info | warn | error
LOG_LEVEL=info

# Лимит попыток входа с одного IP за 15 минут (по умолчанию 10)
# LOGIN_MAX_ATTEMPTS=10
